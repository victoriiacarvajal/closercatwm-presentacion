# Variables de entorno para desarrollo local (gitignored)
# Copia este archivo a .env.local y reemplaza los valores

# Gemini API Key
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Clarity Project ID for analytics
# Get from https://clarity.microsoft.com/
VITE_CLARITY_PROJECT_ID=your_clarity_project_id_here

# Make Webhook URL for lead capture (REQUIRED for forms)
# Create a webhook in Make.com and paste the URL here
# This is used to capture leads from all landing page forms
VITE_MAKE_WEBHOOK_URL=https://hook.us1.make.com/your_webhook_id_here

# Optional: Calendly URLs for CTAs
VITE_CALENDLY_CUSTOMER_URL=https://calendly.com/your-username
VITE_CALENDLY_PARTNER_URL=https://calendly.com/your-username

# Opcional: otros entornos si los necesitas
# VITE_API_BASE_URL="https://api.tuempresa.com"
